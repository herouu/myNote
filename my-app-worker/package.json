{
  "name": "mynote-api",
  "version": "1.0.0",
  "description": "myNote API - Cloudflare Workers & Node.js",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "npm run dev:worker",
    "deploy": "npm run deploy:worker",
    "dev:worker": "wrangler dev --port 8787",
    "deploy:worker": "wrangler deploy --env production",
    "d1:init:local": "wrangler d1 execute local-mynote-db --local --file=./database/schema.sql",
    "d1:seed:local": "wrangler d1 execute local-mynote-db --local --file=./database/seed.sql",
    "d1:create:remote": "wrangler d1 create mynote-db",
    "d1:init:remote": "wrangler d1 execute mynote-db --remote --file=./database/schema.sql",
    "d1:seed:remote": "wrangler d1 execute mynote-db --remote --file=./database/seed.sql",
    "d1:export": "wrangler d1 export mynote-db --remote --output=./database/backup.sql",
    "dev:server": "tsx src/server/index.ts",
    "start:server": "node dist/server/index.js",
    "build": "tsc",
    "build:worker": "npm run build",
    "build:server": "npm run build"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.2",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "better-sqlite3": "^11.6.0",
    "hono": "^4.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "@hono/node-server": "^1.13.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.90.0"
  }
}
